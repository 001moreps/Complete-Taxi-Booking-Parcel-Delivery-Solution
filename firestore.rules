rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRole() { return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null; }
    function isAdmin() { return userRole() == 'ADMIN'; }
    function isRepairer() { return userRole() == 'REPAIRER'; }
    function isCustomer() { return userRole() == 'CUSTOMER'; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    match /catalogue_categories/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /catalogue_brands/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /catalogue_families/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /catalogue_models/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /repair_services/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /device_services/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /parts/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    match /system_config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /repair_jobs/{jobId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.repairerId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /quotes/{quoteId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.repairerId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
      match /quote_items/{itemId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /messages/{messageId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /audit_logs/{id} { allow read: if isAdmin(); allow write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
